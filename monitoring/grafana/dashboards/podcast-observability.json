{
  "uid": "podcast-observability",
  "title": "Podcast Observability",
  "tags": ["podcast", "compose"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus-compose" },
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(http_requests_total{route!=\"/metrics\"}[5m]))",
          "legendFormat": "{{route}} {{status_code}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container memory",
      "datasource": { "type": "prometheus", "uid": "prometheus-compose" },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name!=\"\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "MySQL connected threads",
      "datasource": { "type": "prometheus", "uid": "prometheus-compose" },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Nginx active connections",
      "datasource": { "type": "prometheus", "uid": "prometheus-compose" },
      "targets": [
        { "expr": "nginx_connections_active", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Container logs",
      "datasource": { "type": "loki", "uid": "loki-compose" },
      "targets": [
        { "expr": "{job=\"docker\"}", "refId": "A" }
      ],
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "options": { "showTime": true, "showLabels": true, "sortOrder": "Descending", "wrapLogMessage": true }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] }
}